<?xml version="1.0" encoding="utf-8"?>
<CommandTable xmlns="http://schemas.microsoft.com/VisualStudio/2005-10-18/CommandTable">
  <Extern href="stdidcmd.h" />
  <Extern href="vsshlids.h" />

  <Commands package="guidCodexPackage">
    <Groups>
      <Group guid="guidCodexCommandSet" id="MyMenuGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_MENU_VIEW" />
      </Group>
      <Group guid="guidCodexCommandSet" id="CodexEditorContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_CODEWIN" />
      </Group>
      <Group guid="guidCodexCommandSet" id="CodexItemContextGroup" priority="0x0600">
        <Parent guid="guidSHLMainMenu" id="IDM_VS_CTXT_ITEMNODE" />
      </Group>
    </Groups>

    <Buttons>
      <Button guid="guidCodexCommandSet" id="ShowCodexToolWindowCommand" priority="0x0100" type="Button">
        <Parent guid="guidCodexCommandSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>VSAI</ButtonText>
          <CommandName>View.VSAI</CommandName>
          <LocCanonicalName>View.VSAI</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidCodexCommandSet" id="OpenSidebarCommand" priority="0x0110" type="Button">
        <Parent guid="guidCodexCommandSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Open Codex Sidebar</ButtonText>
          <CommandName>VSAI.OpenSidebar</CommandName>
          <LocCanonicalName>VSAI.OpenSidebar</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidCodexCommandSet" id="NewCodexAgentCommand" priority="0x0120" type="Button">
        <Parent guid="guidCodexCommandSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>New Codex Agent</ButtonText>
          <CommandName>VSAI.NewAgent</CommandName>
          <LocCanonicalName>VSAI.NewAgent</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidCodexCommandSet" id="OpenCodexSettingsCommand" priority="0x0130" type="Button">
        <Parent guid="guidCodexCommandSet" id="MyMenuGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Codex Settings</ButtonText>
          <CommandName>VSAI.OpenSettings</CommandName>
          <LocCanonicalName>VSAI.OpenSettings</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidCodexCommandSet" id="AddSelectionToThreadCommand" priority="0x0110" type="Button">
        <Parent guid="guidCodexCommandSet" id="CodexEditorContextGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Add to Codex Thread</ButtonText>
          <CommandName>VSAI.AddToThread</CommandName>
          <LocCanonicalName>VSAI.AddToThread</LocCanonicalName>
        </Strings>
      </Button>
      <Button guid="guidCodexCommandSet" id="AddFileToThreadCommand" priority="0x0100" type="Button">
        <Parent guid="guidCodexCommandSet" id="CodexItemContextGroup" />
        <Icon guid="guidImages" id="bmpPic1" />
        <Strings>
          <ButtonText>Add File to Codex Thread</ButtonText>
          <CommandName>VSAI.AddFileToThread</CommandName>
          <LocCanonicalName>VSAI.AddFileToThread</LocCanonicalName>
        </Strings>
      </Button>
    </Buttons>

    <Bitmaps>
      <Bitmap guid="guidImages" href="Resources\Images.png" usedList="bmpPic1" />
    </Bitmaps>
  </Commands>

  <KeyBindings>
    <KeyBinding guid="guidCodexCommandSet" id="ShowCodexToolWindowCommand" editor="guidVSStd97" key1="K" mod1="Control" key2="C" mod2="Control Alt" />
  </KeyBindings>

  <Symbols>
    <GuidSymbol name="guidCodexPackage" value="{2100D026-139B-4827-A538-306555F3C0BC}" />
    <GuidSymbol name="guidCodexCommandSet" value="{D4816E82-BF74-488D-8CE6-F3FBCA38A05E}">
      <IDSymbol name="MyMenuGroup" value="0x1020" />
      <IDSymbol name="CodexEditorContextGroup" value="0x1021" />
      <IDSymbol name="CodexItemContextGroup" value="0x1022" />
      <IDSymbol name="ShowCodexToolWindowCommand" value="0x0100" />
      <IDSymbol name="OpenSidebarCommand" value="0x0101" />
      <IDSymbol name="NewCodexAgentCommand" value="0x0102" />
      <IDSymbol name="AddSelectionToThreadCommand" value="0x0103" />
      <IDSymbol name="AddFileToThreadCommand" value="0x0104" />
      <IDSymbol name="OpenCodexSettingsCommand" value="0x0107" />
    </GuidSymbol>
    <GuidSymbol name="guidImages" value="{3CDC7701-15F4-48AD-A3D5-EEEBDBB2BA30}">
      <IDSymbol name="bmpPic1" value="1" />
    </GuidSymbol>
  </Symbols>
</CommandTable>
